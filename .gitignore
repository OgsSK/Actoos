# ============================================
# ACTOOS — .gitignore
# ============================================

# ========== Dependencies ==========
node_modules/

# ========== Build outputs ==========
dist/
build/
.next/
out/
*.tsbuildinfo

# ========== Python ==========
__pycache__/
*.py[cod]
*.pyc
venv/
.venv/
env/
.pytest_cache/
.ruff_cache/

# ========== Tests & coverage ==========
coverage/
test_reports/
.pytest_cache/

# ========== Environment & secrets ==========
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
*token.json*
*credentials.json*

# ========== Logs ==========
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ========== IDE ==========
.idea/
.vscode/
*.swp
*.swo
*~

# ========== OS ==========
.DS_Store
Thumbs.db

# ========== Emergent Agent ==========
.emergent/
.gitconfig

# ========== Misc ==========
*.bak
*.tmp
*.temp
.pnp
.pnp.js
.yarn/install-state.gz
next-env.d.ts
