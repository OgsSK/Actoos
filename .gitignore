# ============================================
# ACTOOS - .gitignore
# ============================================

# ===================
# Dossiers à ignorer
# ===================

# Emergent Agent (NE PAS COMMITER)
.emergent/
.gitconfig

# Dependencies
node_modules/
/node_modules

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env.local

# Testing & Reports
test_reports/
tests/
coverage/
.pytest_cache/
.ruff_cache/
*.test.js
*.spec.js

# ===================
# Fichiers de build
# ===================

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# React
/build
dist/

# ===================
# IDE & Editeurs
# ===================
.idea/
.vscode/
*.swp
*.swo
*~

# ===================
# Environnement
# ===================
.env
.env.*
!.env.example
*token.json*
*credentials.json*

# ===================
# Logs
# ===================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dump.rdb

# ===================
# Système
# ===================
.DS_Store
*.pem
Thumbs.db

# ===================
# Yarn/NPM
# ===================
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
yarn.lock
package-lock.json

# ===================
# Divers
# ===================
*.bak
*.tmp
*.temp
vitrine/node_modules/@next/swc-linux-arm64-gnu/next-swc.linux-arm64-gnu.node
actoos-one/node_modules/.cache/default-development/3.pack
actoos-one/node_modules/.cache/default-development/32.pack
actoos-one/node_modules/.cache/default-development/14.pack
actoos-pro/frontend/node_modules/.cache/default-development/29.pack
-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
