# ===========================================
# ACTOOS BACKEND - Variables d'environnement
# ===========================================
# Copiez ce fichier en .env et remplissez les valeurs

# ===== BASE DE DONNÉES =====
MONGO_URL=mongodb://localhost:27017/actoos
DB_NAME=actoos_prod

# ===== SÉCURITÉ =====
JWT_SECRET=votre_secret_jwt_minimum_32_caracteres_aleatoires

# ===== STRIPE (Paiements) =====
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# IDs des prix (créés dans Stripe Dashboard > Products)
STRIPE_PRICE_STARTUP=price_xxxx
STRIPE_PRICE_PRO=price_xxxx
STRIPE_PRICE_ENTERPRISE=price_xxxx

# ===== GOOGLE OAUTH (Calendrier) =====
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ===== RESEND (Emails) =====
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=notifications@actoos.com

# ===== TWILIO (SMS) - Optionnel =====
# Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_PHONE_NUMBER=+32xxxx

# ===== URLS =====
FRONTEND_URL=https://actoos.com
CORS_ORIGINS=https://actoos.com,https://www.actoos.com

# ===== STOCKAGE CLOUD (Optionnel) =====
# Pour stocker photos/logos sur le cloud
CLOUDINARY_URL=cloudinary://xxxx
# ou
AWS_ACCESS_KEY_ID=xxxx
AWS_SECRET_ACCESS_KEY=xxxx
AWS_S3_BUCKET=actoos-uploads

# ===== ADMIN =====
# Emails des super admins (séparés par virgule)
SUPER_ADMIN_EMAILS=admin@actoos.com,votre@email.com
