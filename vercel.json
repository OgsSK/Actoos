{
  "version": 2,
  "buildCommand": "cd actoos-pro/frontend && yarn install && yarn build",
  "outputDirectory": "actoos-pro/frontend/build",
  "framework": null,
  "installCommand": "cd actoos-pro/frontend && yarn install",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
